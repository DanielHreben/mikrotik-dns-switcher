# MikroTik DNS Switcher Environment Variables
# Copy this file to .env and fill in the values

# MikroTik API connection
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USERNAME=admin
MIKROTIK_PASSWORD=changeme

# DNS settings
CUSTOM_DNS=8.8.8.8

# Web server
PORT=3000

# Local development: trust X-Real-IP from anyone, so ?ip= in the page can act
# for another device. Never in production.
ALLOW_TARGET_IP=true

# Production behind a reverse proxy (see README):
# TRUSTED_PROXY=172.19.0.100
# ALLOWED_RANGE=192.168.88.20-192.168.88.99
# MIKROTIK_TLS_CA=/path/router-ca.crt
