# MikroTik DNS Switcher Environment Variables
# Copy this file to .env and fill in the values

# MikroTik API connection
MIKROTIK_HOST=192.168.88.1
MIKROTIK_USERNAME=dns-switcher
MIKROTIK_PASSWORD=changeme

# DNS settings
CUSTOM_DNS=8.8.8.8

# Web server
PORT=3000

# Production behind a reverse proxy (see README). Set all of these:
# TRUSTED_PROXY=172.19.0.100
# ALLOWED_RANGE=192.168.88.20-192.168.88.99
# ALLOWED_HOSTS=dns-switcher.home
# MIKROTIK_TLS_CA=/path/router-ca.crt
# MAX_MANAGED_LEASES=32

# Local development only: trust X-Real-IP from anyone, so ?ip= in the page can
# act for another device (and talk to the router without TLS). Never in production.
# ALLOW_TARGET_IP=true
